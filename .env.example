# ==============================================================================
# Environment Configuration - Adaptive Research Gap AI Monorepo
# ==============================================================================

# Database Connection (Relational + Vector DB)
# In Docker compose: postgresql+asyncpg://postgres:postgres@db:5432/researchgap
# In Local runs: postgresql+asyncpg://postgres:postgres@localhost:5432/researchgap
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchgap

# Redis Connection (Celery broker and task queue)
# In Docker compose: redis://redis:6379/0
# In Local runs: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# LLM Orchestrator credentials
# Required for full text vector indexing and multi-agent synthesis nodes
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Celery Asynchronous configuration (set to true to run background jobs inside the web worker without Redis)
CELERY_ALWAYS_EAGER=false
